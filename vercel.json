{
  "cleanUrls": true,
  "redirects": [
    { "source": "/article", "has": [{ "type": "query", "key": "id", "value": "(?<id>[a-z0-9-]+)" }], "destination": "/articles/:id", "permanent": true },
    { "source": "/article.html", "has": [{ "type": "query", "key": "id", "value": "(?<id>[a-z0-9-]+)" }], "destination": "/articles/:id", "permanent": true }
  ]
}
